# =============================================================
#  Darmyth — .gitignore
# =============================================================

# -----------------------------------------------------------------
# SECRETS — never commit these
# -----------------------------------------------------------------
config/.env
*.env
.env.*
secrets.yaml
api_keys.txt

# -----------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so

# Virtual environment
venv/
env/
.venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# -----------------------------------------------------------------
# AI MODEL CACHE  (large files, re-downloads automatically)
# -----------------------------------------------------------------
*.bin
*.safetensors
*.gguf
*.pt
*.onnx

# Hugging Face cache (Whisper + MiniLM download here)
.cache/
~/.cache/huggingface/

# -----------------------------------------------------------------
# DATABASE & MEMORY  (user-specific, rebuilds from data/)
# -----------------------------------------------------------------
memory_db/
*.db
*.sqlite
*.sqlite3
chroma.sqlite3

# -----------------------------------------------------------------
# DATA  (personal notes and conversations stay local)
# -----------------------------------------------------------------
data/notes/*
data/conversations/*
data/gestures/*

# Keep the folder structure but not the contents
!data/notes/.gitkeep
!data/conversations/.gitkeep
!data/gestures/.gitkeep

# -----------------------------------------------------------------
# LOGS & RUNTIME FILES
# -----------------------------------------------------------------
logs/
*.log
*.log.*
darmyth.pid

# -----------------------------------------------------------------
# AUDIO TEMP FILES  (generated by edge-tts during TTS playback)
# -----------------------------------------------------------------
*.mp3
*.wav
*.ogg
temp_audio/

# -----------------------------------------------------------------
# OS FILES
# -----------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# -----------------------------------------------------------------
# EDITORS & IDEs
# -----------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
Session.vim

# Sublime Text
*.sublime-project
*.sublime-workspace

# Jupyter (if you ever experiment in notebooks)
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------
# TESTING & COVERAGE
# -----------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# -----------------------------------------------------------------
# MISC
# -----------------------------------------------------------------
*.bak
*.tmp
*.temp
.benchmarks/



data/*.task